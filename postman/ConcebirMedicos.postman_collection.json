{
  "info": {
    "name": "Concebir Médicos API",
    "description": "Servicio REST de Concebir Médicos (Lambda + DynamoDB + HTTP API, login con Cognito).\n\n1. Completa la variable `password`.\n2. Ejecuta **0. Auth → Login**: guarda `accessToken` automáticamente.\n3. El resto de requests heredan `Bearer {{accessToken}}`.\n\nLos requests de creación guardan el id creado (`nuevo*`) para que Actualizar/Eliminar trabajen sobre ese registro y no sobre los datos de ejemplo.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "0. Auth (Cognito)",
      "item": [
        {
          "name": "Login (USER_PASSWORD_AUTH)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const r = pm.response.json().AuthenticationResult;",
                  "pm.collectionVariables.set('accessToken', r.AccessToken);",
                  "if (r.RefreshToken) pm.collectionVariables.set('refreshToken', r.RefreshToken);"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-amz-json-1.1"
              },
              {
                "key": "X-Amz-Target",
                "value": "AWSCognitoIdentityProviderService.InitiateAuth"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"AuthFlow\": \"USER_PASSWORD_AUTH\",\n  \"ClientId\": \"{{cognitoClientId}}\",\n  \"AuthParameters\": {\n    \"USERNAME\": \"{{cmp}}\",\n    \"PASSWORD\": \"{{password}}\"\n  }\n}"
            },
            "url": {
              "raw": "{{cognitoUrl}}/",
              "protocol": "https",
              "host": [
                "cognito-idp",
                "us-east-1",
                "amazonaws",
                "com"
              ],
              "path": [
                ""
              ]
            },
            "description": "Obtiene el access token (60 min) y el refresh token (30 días). Los guarda en las variables de la colección `accessToken` y `refreshToken`."
          }
        },
        {
          "name": "Renovar token (REFRESH_TOKEN_AUTH)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const r = pm.response.json().AuthenticationResult;",
                  "pm.collectionVariables.set('accessToken', r.AccessToken);",
                  "if (r.RefreshToken) pm.collectionVariables.set('refreshToken', r.RefreshToken);"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-amz-json-1.1"
              },
              {
                "key": "X-Amz-Target",
                "value": "AWSCognitoIdentityProviderService.InitiateAuth"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"AuthFlow\": \"REFRESH_TOKEN_AUTH\",\n  \"ClientId\": \"{{cognitoClientId}}\",\n  \"AuthParameters\": {\n    \"REFRESH_TOKEN\": \"{{refreshToken}}\"\n  }\n}"
            },
            "url": {
              "raw": "{{cognitoUrl}}/",
              "protocol": "https",
              "host": [
                "cognito-idp",
                "us-east-1",
                "amazonaws",
                "com"
              ],
              "path": [
                ""
              ]
            },
            "description": "Renueva el access token con el refresh token (mismo flujo que el login biométrico de la app)."
          }
        }
      ]
    },
